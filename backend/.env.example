# =========================================================
# Annapurna Bhakti Bhandar — Environment Configuration
# Copy this file to .env and fill in real values before
# deploying to production. Anything marked CHANGE_ME must
# be replaced.
# =========================================================

# ---- Shop identity (shown in footer, WhatsApp button, etc.) ----
SHOP_NAME=Annapurna Bhakti Bhandar
SHOP_PHONE=CHANGE_ME
SHOP_EMAIL=CHANGE_ME
SHOP_ADDRESS=CHANGE_ME
WHATSAPP_NUMBER=CHANGE_ME

# ---- Admin login (used to seed the first admin user) ----
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# ---- Database ----
# For quick local testing, SQLite works out of the box:
DATABASE_URL=sqlite:///./annapurna.db
# For production, use PostgreSQL, e.g.:
# DATABASE_URL=postgresql://annapurna:annapurna_change_me@localhost:5432/annapurna_db

# ---- Security ----
SECRET_KEY=CHANGE_ME

# ---- CORS ----
# Comma separated list of allowed origins, or * for all (development only)
CORS_ORIGINS=*

# ---- Delivery ----
DELIVERY_CHARGE=50
FREE_DELIVERY_ABOVE=999
